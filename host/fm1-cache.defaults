# Apply after firmware/sdkconfig.defaults with ESP-IDF 5.5.
CONFIG_SYNTHDEF_DIAGNOSTICS=y
CONFIG_SYNTHDEF_FM1_COMPAT=y
CONFIG_SYNTHDEF_TOUCH_UI=y
CONFIG_SYNTHDEF_INTERNAL_RINGS=y
CONFIG_SYNTHDEF_INTERNAL_VOICE_ARENA_SAMPLES=0
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# Keep Wi-Fi packet storage away from the audio states and DMA reserve.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# Bound out-of-order receive storage as in the measured Wi-Fi configuration.
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
