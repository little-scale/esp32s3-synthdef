diff --git a/firmware/main/usb_console.c b/firmware/main/usb_console.c
new file mode 100644
--- /dev/null
+++ b/firmware/main/usb_console.c
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "usb_console.h"
+#include "sdkconfig.h"
+#if CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED
+#include <fcntl.h>
+#include <stdio.h>
+#include <unistd.h>
+#include "driver/usb_serial_jtag.h"
+#include "driver/usb_serial_jtag_vfs.h"
+#endif
+
+esp_err_t usb_console_init(void)
+{
+#if CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED
+    usb_serial_jtag_driver_config_t config = {
+        .rx_buffer_size = 2048,
+        .tx_buffer_size = 4096,
+    };
+    esp_err_t error = usb_serial_jtag_driver_install(&config);
+    if (error != ESP_OK) return error;
+    usb_serial_jtag_vfs_use_driver();
+    /* Blocking getchar would stop standalone polling whenever no host sends
+     * commands. The driver buffers bytes, but EOF must keep yielding as before. */
+    int flags = fcntl(STDIN_FILENO, F_GETFL);
+    if (flags < 0 || fcntl(STDIN_FILENO, F_SETFL, flags | O_NONBLOCK) < 0)
+        return ESP_FAIL;
+    if (setvbuf(stdin, NULL, _IONBF, 0) != 0) return ESP_FAIL;
+#endif
+    return ESP_OK;
+}
diff --git a/firmware/main/usb_console.h b/firmware/main/usb_console.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/usb_console.h
@@ -0,0 +1,7 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include "esp_err.h"
+
+/* Keep input polling nonblocking for standalone buttons/network work. Output
+ * uses the SDK's bounded, yielding buffered transport instead of FIFO spins. */
+esp_err_t usb_console_init(void);
diff --git a/host/test_usb_console.py b/host/test_usb_console.py
new file mode 100644
--- /dev/null
+++ b/host/test_usb_console.py
@@ -0,0 +1,56 @@
+"""Compile the real USB console initializer against driver stubs, without USB."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT=Path(__file__).resolve().parents[1]
+
+
+class ConsoleTests(unittest.TestCase):
+    def test_buffered_init_polling_and_error_paths(self):
+        with tempfile.TemporaryDirectory() as folder:
+            path=Path(folder);(path/'driver').mkdir()
+            (path/'esp_err.h').write_text('#pragma once\ntypedef int esp_err_t;\n#define ESP_OK 0\n#define ESP_FAIL -1\n')
+            (path/'driver/usb_serial_jtag.h').write_text('#include "esp_err.h"\ntypedef struct {unsigned tx_buffer_size,rx_buffer_size;} usb_serial_jtag_driver_config_t;\nesp_err_t usb_serial_jtag_driver_install(usb_serial_jtag_driver_config_t *);\n')
+            (path/'driver/usb_serial_jtag_vfs.h').write_text('void usb_serial_jtag_vfs_use_driver(void);\n')
+            (path/'check.c').write_text(r'''
+#include <assert.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include "usb_console.h"
+#include "driver/usb_serial_jtag.h"
+static int installed, selected, fail;
+int usb_serial_jtag_driver_install(usb_serial_jtag_driver_config_t *config) {
+    assert(config->rx_buffer_size==2048 && config->tx_buffer_size==4096);
+    installed++;return fail?-7:0;
+}
+void usb_serial_jtag_vfs_use_driver(void) { assert(installed==1);selected++; }
+int main(int argc,char **argv) {
+    assert(argc==2);int mode=atoi(argv[1]);fail=mode==1;
+    int before=fcntl(0,F_GETFL);assert(before>=0);
+    if(mode==2)close(0);
+    int result=usb_console_init();
+#if CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED
+    if(mode==0) {assert(result==0 && installed==1 && selected==1);assert(fcntl(0,F_GETFL)&O_NONBLOCK);}
+    if(mode==1) {assert(result==-7 && installed==1 && selected==0);assert(fcntl(0,F_GETFL)==before);}
+    if(mode==2) {assert(result==-1 && installed==1 && selected==1);}
+#else
+    assert(result==0 && !installed && !selected);
+    if(mode!=2)assert(fcntl(0,F_GETFL)==before);
+#endif
+}
+''')
+            for enabled in (0,1):
+                (path/'sdkconfig.h').write_text(f'#define CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED {enabled}\n')
+                exe=path/f'check-{enabled}'
+                subprocess.run(['cc','-std=c99','-Wall','-Wextra','-Werror',
+                    '-fsanitize=undefined,bounds','-fno-sanitize-recover=all',
+                    '-I'+str(path),'-I'+str(ROOT/'firmware/main'),'-include',str(path/'sdkconfig.h'),
+                    str(ROOT/'firmware/main/usb_console.c'),str(path/'check.c'),'-o',str(exe)],check=True)
+                for mode in (0,1,2):
+                    subprocess.run([str(exe),str(mode)],stdin=subprocess.DEVNULL,check=True)
+
+
+if __name__=='__main__':unittest.main()
