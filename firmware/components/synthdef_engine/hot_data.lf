# Keep the admitted voice's kernels off the shared flash instruction cache.
# Lookup values and rendering algorithms remain unchanged. The persistent-delay
# preset retains the immutable table in flash.
[mapping:synthdef_hot_data]
archive: libsynthdef_engine.a
entries:
    if SYNTHDEF_INTERNAL_RINGS = y:
        fm_render:rg_process (noflash_text)
        fm_render:rings_render (noflash_text)
        fm_render:rg_hermite (noflash_text)
        fm_render:rg_fx_write (noflash_text)
    if SYNTHDEF_INTERNAL_SINE = y:
        fm_render:fm_sine (noflash_data)
    if SYNTHDEF_INTERNAL_KERNELS = y:
        fm_render:render_graph (noflash_text)
        fm_render:fast_arithmetic (noflash_text)
        fm_render:fast_sine (noflash_text)
        fm_render:fast_envelope (noflash_text)
        fm_render:fast_pan (noflash_text)
        fm_render:fast_filter (noflash_text)
        fm_render:fast_lag (noflash_text)
        fm_render:fast_unary (noflash_text)
        fm_render:binary (noflash_text)
        fm_render:envelope (noflash_text)
        fm_render:envelope_init (noflash_text)
        fm_render:segment (noflash_text)
        fm_render:sine_control_step (noflash_text)
        fm_render:fm_start (noflash_text)
        fm_render:fm_seed (noflash_text)
        fm_render:fm_set (noflash_text)
        fm_render:fm_prepare (noflash_text)
        fm_render:fm_render_input (noflash_text)
        fm_render:fm_render (noflash_text)
        fm_render:delay_render (noflash_text)
        fm_render:unary (noflash_text)
